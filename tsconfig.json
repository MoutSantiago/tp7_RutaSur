{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@rutasur/shared": ["packages/shared/src/index.js"],
      "@rutasur/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["packages/**/*.js", "services/**/*.js", "apps/**/*.js"],
  "exclude": ["node_modules", "**/.next/**", "**/dist/**"]
}
